- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block for GNU Radio - Dilated ResNet BPSK\
      \ Denoiser\nPaste this into an Embedded Python Block in GNU Radio Companion\n\
      \nParameters to add in the block:\n  - model_path (string): Path to your .pth\
      \ file\n  - base_channels (int): 32 (must match training)\n  - num_blocks (int):\
      \ 6 (must match training)\n\"\"\"\nimport sys\nsys.path.insert(0, '/home/john/Desktop/.venv/lib/python3.12/site-packages')\n\
      sys.path.insert(0, '/usr/lib/python3/dist-packages/gnuradio/__init__.py')\n\n\
      import numpy as np\nfrom gnuradio import gr\nimport torch\nimport torch.nn as\
      \ nn\nimport torch.nn.functional as F\n\n\n# ========================================\n\
      # Model Architecture (from your training)\n# ========================================\n\
      class DilatedResBlock(nn.Module):\n    \"\"\"Residual block with dilated convolution.\"\
      \"\"\n    \n    def __init__(self, channels, kernel_size=5, dilation=1, dropout=0.1):\n\
      \        super().__init__()\n        padding = (kernel_size - 1) * dilation\
      \ // 2\n        \n        self.conv1 = nn.Conv1d(channels, channels, kernel_size=kernel_size,\
      \ \n                               dilation=dilation, padding=padding)\n   \
      \     self.bn1 = nn.BatchNorm1d(channels)\n        self.conv2 = nn.Conv1d(channels,\
      \ channels, kernel_size=kernel_size,\n                               dilation=dilation,\
      \ padding=padding)\n        self.bn2 = nn.BatchNorm1d(channels)\n        self.dropout\
      \ = nn.Dropout(dropout)\n        self.alpha = nn.Parameter(torch.ones(1))\n\
      \        \n    def forward(self, x):\n        residual = x\n        out = F.relu(self.bn1(self.conv1(x)))\n\
      \        out = self.dropout(out)\n        out = self.bn2(self.conv2(out))\n\
      \        out = F.relu(out + self.alpha * residual)\n        return out\n\n\n\
      class ChannelAttention(nn.Module):\n    \"\"\"Lightweight channel attention\
      \ mechanism.\"\"\"\n    \n    def __init__(self, channels, reduction=8):\n \
      \       super().__init__()\n        self.avg_pool = nn.AdaptiveAvgPool1d(1)\n\
      \        self.max_pool = nn.AdaptiveMaxPool1d(1)\n        self.fc = nn.Sequential(\n\
      \            nn.Linear(channels, channels // reduction, bias=False),\n     \
      \       nn.ReLU(),\n            nn.Linear(channels // reduction, channels, bias=False),\n\
      \        )\n        \n    def forward(self, x):\n        b, c, _ = x.size()\n\
      \        avg_out = self.fc(self.avg_pool(x).view(b, c))\n        max_out = self.fc(self.max_pool(x).view(b,\
      \ c))\n        attention = torch.sigmoid(avg_out + max_out).view(b, c, 1)\n\
      \        return x * attention\n\n\nclass DilatedResNet(nn.Module):\n    \"\"\
      \"Dilated ResNet for signal denoising.\"\"\"\n    \n    def __init__(self, input_size=512,\
      \ base_channels=32, num_blocks=6, dropout=0.1):\n        super().__init__()\n\
      \        \n        self.input_conv = nn.Sequential(\n            nn.Conv1d(1,\
      \ base_channels, kernel_size=7, padding=3),\n            nn.BatchNorm1d(base_channels),\n\
      \            nn.ReLU()\n        )\n        \n        dilations = [1, 2, 4, 8,\
      \ 16, 16]\n        self.res_blocks = nn.ModuleList()\n        for i, dilation\
      \ in enumerate(dilations[:num_blocks]):\n            self.res_blocks.append(\n\
      \                DilatedResBlock(base_channels, kernel_size=5, dilation=dilation,\
      \ dropout=dropout)\n            )\n        \n        if num_blocks > 6:\n  \
      \          reverse_dilations = [8, 4, 2, 1]\n            for dilation in reverse_dilations[:num_blocks-6]:\n\
      \                self.res_blocks.append(\n                    DilatedResBlock(base_channels,\
      \ kernel_size=5, dilation=dilation, dropout=dropout)\n                )\n  \
      \      \n        self.attention = ChannelAttention(base_channels, reduction=4)\n\
      \        \n        self.refinement = nn.Sequential(\n            nn.Conv1d(base_channels,\
      \ base_channels, kernel_size=5, padding=2),\n            nn.BatchNorm1d(base_channels),\n\
      \            nn.ReLU(),\n            nn.Dropout(dropout)\n        )\n      \
      \  \n        self.output_conv = nn.Conv1d(base_channels, 1, kernel_size=7, padding=3)\n\
      \        self.residual_weight = nn.Parameter(torch.tensor(0.1))\n        \n\
      \    def forward(self, x):\n        identity = x.clone()\n        x = x.unsqueeze(1)\n\
      \        \n        x = self.input_conv(x)\n        skip = x.clone()\n      \
      \  \n        for res_block in self.res_blocks:\n            x = res_block(x)\n\
      \        \n        x = self.attention(x)\n        x = x + skip\n        x =\
      \ self.refinement(x)\n        \n        noise_estimate = self.output_conv(x).squeeze(1)\n\
      \        clean_estimate = identity - self.residual_weight * noise_estimate\n\
      \        \n        return clean_estimate, noise_estimate\n\n\n# ========================================\n\
      # GNU Radio Block Implementation\n# ========================================\n\
      class blk(gr.sync_block):\n    \"\"\"\n    Dilated ResNet BPSK Signal Denoiser\
      \ - Non-blocking version\n    \"\"\"\n    \n    def __init__(self, model_path='/home/john/es7_project/code/resnet/bpsk_dilated_resnet_model.pth',\
      \ base_channels=32, num_blocks=6):\n        gr.sync_block.__init__(\n      \
      \      self,\n            name='ML Jammer Suppressor',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n        \n        self.block_len\
      \ = 256\n        self.device = torch.device('cuda' if torch.cuda.is_available()\
      \ else 'cpu')\n        \n        print(f\"[ML Block] Using device: {self.device}\"\
      )\n        print(f\"[ML Block] Loading model from: {model_path}\")\n       \
      \ \n        try:\n            self.model = DilatedResNet(\n                input_size=512,\n\
      \                base_channels=base_channels,\n                num_blocks=num_blocks,\n\
      \                dropout=0.1\n            ).to(self.device)\n            \n\
      \            checkpoint = torch.load(model_path, map_location=self.device)\n\
      \            self.model.load_state_dict(checkpoint['model_state_dict'])\n  \
      \          self.model.eval()\n            print(f\"[ML Block] Model loaded successfully!\"\
      )\n            self.model_loaded = True\n        except Exception as e:\n  \
      \          print(f\"[ML Block] ERROR loading model: {e}\")\n            print(f\"\
      [ML Block] Running in PASSTHROUGH mode\")\n            self.model_loaded = False\n\
      \        \n        self.buffer = np.array([], dtype=np.complex64)\n        self.output_buffer\
      \ = np.array([], dtype=np.complex64)\n        self.blocks_processed = 0\n  \
      \      \n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out = output_items[0]\n        n_samples = len(in0)\n        \n   \
      \     # If model not loaded, just passthrough\n        if not self.model_loaded:\n\
      \            out[:n_samples] = in0[:n_samples]\n            return n_samples\n\
      \        \n        # Add to buffer\n        self.buffer = np.concatenate([self.buffer,\
      \ in0])\n        \n        # Process blocks when we have enough samples\n  \
      \      while len(self.buffer) >= self.block_len:\n            block = self.buffer[:self.block_len]\n\
      \            \n            try:\n                # Convert to model format\n\
      \                x_interleaved = np.stack([block.real, block.imag], axis=-1).reshape(-1).astype(np.float32)\n\
      \                \n                # Run model\n                with torch.no_grad():\n\
      \                    x_tensor = torch.from_numpy(x_interleaved).unsqueeze(0).to(self.device)\n\
      \                    clean_pred, _ = self.model(x_tensor)\n                \
      \    y_np = clean_pred.cpu().numpy().squeeze()\n                \n         \
      \       # Convert back to complex\n                y_complex = y_np[::2] + 1j\
      \ * y_np[1::2]\n                \n                # Handle size mismatch\n \
      \               if len(y_complex) < self.block_len:\n                    y_complex\
      \ = np.pad(y_complex, (0, self.block_len - len(y_complex)), mode='edge')\n \
      \               elif len(y_complex) > self.block_len:\n                    y_complex\
      \ = y_complex[:self.block_len]\n                \n                # Add to output\
      \ buffer\n                self.output_buffer = np.concatenate([self.output_buffer,\
      \ y_complex])\n                self.blocks_processed += 1\n                \n\
      \            except Exception as e:\n                if self.blocks_processed\
      \ == 0:\n                    print(f\"[ML Block] Processing error: {e}\")\n\
      \                # On error, just pass through the block\n                self.output_buffer\
      \ = np.concatenate([self.output_buffer, block])\n            \n            #\
      \ Remove processed block from input buffer\n            self.buffer = self.buffer[self.block_len:]\n\
      \        \n        # Output as many samples as we have available\n        n_output\
      \ = min(len(self.output_buffer), n_samples)\n        \n        if n_output >\
      \ 0:\n            out[:n_output] = self.output_buffer[:n_output]\n         \
      \   self.output_buffer = self.output_buffer[n_output:]\n        else:\n    \
      \        # No output ready yet, passthrough input\n            out[:n_samples]\
      \ = in0[:n_samples]\n            n_output = n_samples\n        \n        if\
      \ self.blocks_processed % 10 == 0 and self.blocks_processed > 0:\n         \
      \   print(f\"[ML Block] Processed {self.blocks_processed} blocks\")\n      \
      \  \n        return n_output\n"
    affinity: ''
    alias: ''
    base_channels: '32'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    model_path: '''/home/john/es7_project/code/resnet/bpsk_dilated_resnet_model.pth'''
    num_blocks: '6'
  states:
    _io_cache: ('ML Jammer Suppressor', 'blk', [('model_path', "'/home/john/es7_project/code/resnet/bpsk_dilated_resnet_model.pth'"),
      ('base_channels', '32'), ('num_blocks', '6')], [('0', 'complex', 1)], [('0',
      'complex', 1)], '\n    Dilated ResNet BPSK Signal Denoiser - Non-blocking version\n    ',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1272, 280.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import sys\nsys.path.insert(0, '/home/john/Desktop/.venv/lib/python3.12/site-packages')\n\
      sys.path.insert(0, '/usr/lib/python3/dist-packages/gnuradio/__init__.py')\n\n\
      import numpy as np\nfrom gnuradio import gr\nimport random\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Random Phase Rotation',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n        self.block_size = 256\n\
      \        self.current_phase = 2 * np.pi * random.random()\n        self.sample_count\
      \ = 0\n        \n    def work(self, input_items, output_items):\n        in0\
      \ = input_items[0]\n        out = output_items[0]\n        \n        idx = 0\n\
      \        while idx < len(in0):\n            # How many samples left in current\
      \ block?\n            samples_in_block = self.block_size - (self.sample_count\
      \ % self.block_size)\n            samples_to_process = min(samples_in_block,\
      \ len(in0) - idx)\n            \n            # Apply current phase to these\
      \ samples\n            out[idx:idx+samples_to_process] = in0[idx:idx+samples_to_process]\
      \ * np.exp(1j * self.current_phase)\n            \n            idx += samples_to_process\n\
      \            self.sample_count += samples_to_process\n            \n       \
      \     # If we completed a block, get new random phase\n            if self.sample_count\
      \ % self.block_size == 0:\n                self.current_phase = 2 * np.pi *\
      \ random.random()\n        \n        return len(in0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
